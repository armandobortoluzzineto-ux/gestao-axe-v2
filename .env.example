# Variáveis de ambiente para o Supabase
# Copie este arquivo para .env.local e preencha com suas credenciais

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Variáveis opcionais para autenticação server-side (se necessário)
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico

# Configurações adicionais do projeto
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000